# Copy this file to docker/.env and fill in real values. docker/.env is
# gitignored -- never commit real secrets here.

ENVIRONMENT=production
DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Your actual frontend origin(s), comma-are-not-valid-here -- this must be
# valid Python-list-literal JSON, e.g.:
# ALLOWED_ORIGINS=["https://app.example.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]

POSTGRES_USER=dlp_app
POSTGRES_PASSWORD=
POSTGRES_DB=dlp_db
