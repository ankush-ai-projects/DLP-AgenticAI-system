API_TITLE=SentinelDLP AI API
API_VERSION=2.0.0
DEBUG=true
# development | staging | production -- set to "production" to enable
# startup safety checks (rejects insecure SECRET_KEY / wildcard CORS) and
# to disable the public /docs, /redoc, /openapi.json endpoints.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dlp.db
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Brute-force protection on /auth/login and /auth/register
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# TEMPORARY: true = no login required, every request runs as a shared
# dev user, so DB/system scans work immediately. Set to false (and log
# in via /auth/login) once you're ready to test real auth again.
# NEVER set this true with ENVIRONMENT=production -- app.main refuses
# to start if both are set.
SKIP_AUTH=true

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MAX_AGENT_ITERATIONS=8
MAX_AGENT_RETRIES=3
DEFAULT_SCAN_BATCH_SIZE=1000
MAX_SCAN_BATCH_SIZE=10000
MAX_FILE_SIZE_MB=25
SYSTEM_SCAN_ALLOWED_ROOTS=./test_data

# LangGraph is the default runtime. auto = PostgreSQL when configured,
# otherwise a local durable SQLite checkpoint database.
LANGGRAPH_CHECKPOINTER=auto
LANGGRAPH_SQLITE_PATH=./langgraph_checkpoints.sqlite
LANGGRAPH_POSTGRES_URL=
LANGGRAPH_STRICT_MSGPACK=true

# Optional OpenAI-compatible model. Empty values use the deterministic planner.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
SEND_MASKED_METADATA_ONLY=true

# File remediation. Keep this key in a secret manager in production.
REMEDIATION_BACKUP_ROOT=./remediation_backups
REMEDIATION_MASTER_KEY=replace-with-a-separate-long-random-remediation-key
REMEDIATION_DELETE_RETENTION_DAYS=30

# Example secret_ref: payments_mssql
# DLP_SECRET_PAYMENTS_MSSQL={"username":"read_only_user","password":"replace-me"}
uvicorn main:app --reload --port 8001

cd D:\DLP\dlp-system
.\venv\Scripts\Activate.ps1