# Leave empty for local dev -- Vite's dev-server proxy (see vite.config.js)
# forwards /api/* to http://localhost:8001 automatically.
#
# For a production build (npm run build), the proxy no longer exists, so
# set this to your deployed backend's base URL, e.g.:
# VITE_API_BASE_URL=https://api.sentineldlp.example.com
VITE_API_BASE_URL=
uvicorn main:app --reload --port 8001
 .\venv\Scripts\Activate.ps1   